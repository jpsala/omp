+		class NamedActivity extends Text {
+			#visible = true;
+			constructor(
+				text: string,
+				private readonly toolName: string,
+			) {
+				super(text, 1, 0);
+			}
+			getToolActivityName(): string {
+				return this.toolName;
+			}
+			setToolActivityVisible(visible: boolean): void {
+				this.#visible = visible;
+			}
+			override render(width: number): readonly string[] {
+				return this.#visible ? super.render(width) : [];
+			}
+		}
+
+		const transcript = new TranscriptContainer();
+		transcript.setHiddenToolActivityNames([" BASH "]);
+		transcript.addChild(new NamedActivity("bash output", "bash"));
+		transcript.addChild(new NamedActivity("read output", "read"));
+		expect(stripVTControlCharacters(transcript.render(120).join("\n"))).toContain("read output");
+		expect(stripVTControlCharacters(transcript.render(120).join("\n"))).not.toContain("bash output");
+
+		transcript.setToolActivityVisible(false);
+		expect(stripVTControlCharacters(transcript.render(120).join("\n"))).toBe("");
+		transcript.setToolActivityVisible(true);
+		expect(stripVTControlCharacters(transcript.render(120).join("\n"))).toContain("read output");
+		expect(stripVTControlCharacters(transcript.render(120).join("\n"))).not.toContain("bash output");
+
+		transcript.setHiddenToolActivityNames([]);
+		expect(stripVTControlCharacters(transcript.render(120).join("\n"))).toContain("bash output");
+	});
 });
