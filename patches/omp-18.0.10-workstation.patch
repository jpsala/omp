+import { convertToLlm } from "@oh-my-pi/pi-coding-agent/session/messages";
+import { SessionManager } from "@oh-my-pi/pi-coding-agent/session/session-manager";
+import { TempDir } from "@oh-my-pi/pi-utils";
+
+const ECONOMIC_CAP = 272_000;
+const oversizedResult = "context ".repeat(180_000);
+const schema = type({});
+const tool: AgentTool<typeof schema, undefined> = {
+  name: "oversized_result",
+  label: "Oversized result",
+  description: "Return one deliberately oversized deterministic result",
+  parameters: schema,
+  async execute() {
+    return { content: [{ type: "text", text: oversizedResult }], details: undefined };
+  },
+};
+
+describe("economic context outbound smoke", () => {
+  let tempDir: TempDir;
+  let authStorage: AuthStorage;
+  let session: AgentSession;
+
+  afterEach(async () => {
+    await session?.dispose();
+    authStorage?.close();
+    await tempDir?.remove();
+    vi.restoreAllMocks();
+  });
+
+  it("never dispatches a tool continuation above 272k when compaction makes no progress", async () => {
+    tempDir = TempDir.createSync("@omp-economic-context-");
+    authStorage = await AuthStorage.create(path.join(tempDir.path(), "auth.db"));
+    authStorage.setRuntimeApiKey("mock", "test-key");
+    const modelRegistry = new ModelRegistry(authStorage, path.join(tempDir.path(), "models.yml"));
+    const mock: MockModel = createMockModel({
+      contextWindow: 1_000_000,
+      maxTokens: 1_024,
+      cost: {
+        input: 0,
+        output: 0,
+        cacheRead: 0,
+        cacheWrite: 0,
+        longContext: { inputThreshold: ECONOMIC_CAP, input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
+      },
+      responses: [
+        {
+          content: [{ type: "toolCall", id: "oversized-1", name: tool.name, arguments: {} }],
+          usage: { input: 210_000 },
+        },
+        { content: ["must not be requested"] },
+      ],
+    });
+    vi.spyOn(modelRegistry, "getAvailable").mockReturnValue([mock]);
+    vi.spyOn(compactionModule, "prepareCompaction").mockReturnValue(undefined);
+
+    const agent = new Agent({
+      getApiKey: () => "test-key",
+      initialState: { model: mock, systemPrompt: ["Test"], tools: [tool], messages: [] },
+      convertToLlm,
+      streamFn: mock.stream,
+    });
+    const settings = Settings.isolated({
+      "compaction.enabled": true,
+      "compaction.methodOrder": ["soft"],
+      "compaction.thresholdTokens": 220_000,
+      "compaction.midTurnEnabled": true,
+      "compaction.asyncEnabled": false,
+      "compaction.autoContinue": false,
+      "retry.enabled": false,
+      "todo.enabled": false,
+    });
+    session = new AgentSession({
+      agent,
+      sessionManager: SessionManager.inMemory(tempDir.path()),
+      settings,
+      modelRegistry,
+      toolRegistry: new Map([[tool.name, tool]]),
+    });
+    vi.spyOn(session, "shake").mockResolvedValue({
+      mode: "elide",
+      toolResultsDropped: 0,
+      blocksDropped: 0,
+      tokensFreed: 0,
+    });
+
+    await session.prompt("Run the tool");
+
+    const tokenizer = new Tokenizer();
+    const outboundTokens = mock.calls.map(call =>
+      tokenizer.countTokens(call.context.systemPrompt.join("\n")) + tokenizer.countMessages(call.context.messages)
+    );
+    expect(outboundTokens[0]).toBeLessThanOrEqual(ECONOMIC_CAP);
+    expect(outboundTokens.every(tokens => tokens <= ECONOMIC_CAP)).toBe(true);
+    expect(mock.calls).toHaveLength(1);
+  });
+
+  it("never dispatches an oversized new prompt when compaction cannot create a cut point", async () => {
+    tempDir = TempDir.createSync("@omp-economic-prompt-");
+    authStorage = await AuthStorage.create(path.join(tempDir.path(), "auth.db"));
+    authStorage.setRuntimeApiKey("mock", "test-key");
+    const modelRegistry = new ModelRegistry(authStorage, path.join(tempDir.path(), "models.yml"));
+    const mock: MockModel = createMockModel({
+      contextWindow: 1_000_000,
+      maxTokens: 1_024,
+      cost: {
+        input: 0,
+        output: 0,
+        cacheRead: 0,
+        cacheWrite: 0,
+        longContext: { inputThreshold: ECONOMIC_CAP, input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
+      },
+      responses: [{ content: ["must not be requested"] }],
+    });
+    vi.spyOn(modelRegistry, "getAvailable").mockReturnValue([mock]);
+    vi.spyOn(compactionModule, "prepareCompaction").mockReturnValue(undefined);
+
+    const agent = new Agent({
+      getApiKey: () => "test-key",
+      initialState: { model: mock, systemPrompt: ["Test"], tools: [], messages: [] },
+      convertToLlm,
+      streamFn: mock.stream,
+    });
+    session = new AgentSession({
+      agent,
+      sessionManager: SessionManager.inMemory(tempDir.path()),
+      settings: Settings.isolated({
+        "compaction.enabled": true,
+        "compaction.methodOrder": ["soft"],
+        "compaction.thresholdTokens": 220_000,
+        "compaction.midTurnEnabled": true,
+        "compaction.asyncEnabled": false,
+        "compaction.autoContinue": false,
+        "retry.enabled": false,
+        "todo.enabled": false,
+      }),
+      modelRegistry,
+      toolRegistry: new Map(),
+    });
+
+    await expect(session.prompt(oversizedResult)).rejects.toThrow("Provider request blocked before dispatch");
+    expect(mock.calls).toHaveLength(0);
+  });
+});
