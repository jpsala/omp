+function normalizeTranscriptVisibility(value: unknown): TranscriptVisibility | undefined {
+	if (typeof value !== "object" || value === null || Array.isArray(value)) return undefined;
+	const candidate = value as Partial<TranscriptVisibility>;
+	if (
+		typeof candidate.hideThinking !== "boolean" ||
+		typeof candidate.hideToolActivity !== "boolean" ||
+		typeof candidate.hideAssistantToolPreambles !== "boolean" ||
+		typeof candidate.hideTokenUsage !== "boolean" ||
+		!Array.isArray(candidate.hiddenTools) ||
+		!candidate.hiddenTools.every(name => typeof name === "string")
+	) {
+		return undefined;
+	}
+	return {
+		hideThinking: candidate.hideThinking,
+		hideToolActivity: candidate.hideToolActivity,
+		hideAssistantToolPreambles: candidate.hideAssistantToolPreambles,
+		hideTokenUsage: candidate.hideTokenUsage,
+		hiddenTools: [...new Set(candidate.hiddenTools.map(name => name.trim().toLowerCase()).filter(Boolean))].sort(),
+	};
+}
+
+function normalizeTranscriptVisibilityProfiles(value: unknown): Record<string, TranscriptVisibility> {
+	if (typeof value !== "object" || value === null || Array.isArray(value)) return {};
+	const profiles: Record<string, TranscriptVisibility> = {};
+	for (const [rawName, rawProfile] of Object.entries(value)) {
+		const name = rawName.trim().replace(/\s+/g, " ");
+		const profile = normalizeTranscriptVisibility(rawProfile);
+		if (!name || name.length > 64 || /[\x00-\x1f\x7f]/.test(name) || !profile) continue;
+		profiles[name] = profile;
+	}
+	return profiles;
+}
